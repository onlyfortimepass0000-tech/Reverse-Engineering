# REA environment variables — source this or copy into your cloud environment's Setup script.
# All paths assume tools installed to /opt/rea-tools/ by scripts/install-rea.sh.

export GHIDRA_INSTALL_DIR="/opt/rea-tools/ghidra_12.1.4_PUBLIC"
export JAVA_HOME="/usr/lib/jvm/java-21-openjdk-amd64"

# Analysis engines
export REA_KUNA_COMMAND="/opt/rea-tools/kuna/kuna-v1.833-linux-x86_64/kuna"
export REA_JADX_MCP_JAR="/opt/rea-tools/android/jadx-headless-mcp-0.7.1-all.jar"
export REA_APKTOOL_COMMAND="java -jar /opt/rea-tools/android/apktool_3.0.3.jar"
export REA_ADB_PATH="/usr/bin/adb"

# Binary analysis
export REA_RIZIN_COMMAND="/usr/local/bin/rizin"
export REA_OBJDUMP_COMMAND="/usr/bin/objdump"
export REA_GDB_COMMAND="/usr/bin/gdb"

# Exploit dev
export REA_PWNTOOLS_PYTHON="/opt/rea-tools/pwntools-venv/bin/python"
export REA_PWNDBG_GDB="/usr/bin/gdb"
export REA_PWNDBG_GDBINIT="/opt/rea-tools/pwndbg/gdbinit.py"
export REA_PWNDBG_VENV_PATH="/opt/rea-tools/pwndbg/.venv"

# Firmware
export REA_BINWALK_COMMAND="/root/.cargo/bin/binwalk"
export REA_UNBLOB_COMMAND="/usr/local/bin/unblob"

# WebAssembly / JS
export REA_WABT_BIN_DIRECTORY="/opt/rea-tools/wabt/bin"
export REA_WAKARU_COMMAND="/usr/local/bin/wakaru"

# .NET
export REA_ILSPY_CMD_PATH="/root/.dotnet/tools/ilspycmd"
export DOTNET_ROLL_FORWARD="Major"

# Captures
export REA_TSHARK_COMMAND="/usr/bin/tshark"
export REA_MITMDUMP_COMMAND="/usr/local/bin/mitmdump"

# Browser (Chromium, no sandbox for root)
export REA_BROWSER_EXECUTABLE="/opt/pw-browsers/chromium-1194/chrome-linux/chrome"
export REA_BROWSER_NO_SANDBOX="1"

# PATH additions
export PATH="/root/.dotnet/tools:/root/.cargo/bin:$PATH"
